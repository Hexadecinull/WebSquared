{
  "name": "websquared",
  "version": "0.2.1",
  "description": "Ad-free, open-source, lightweight web proxy",
  "license": "GPL-3.0-only",
  "author": "SSMG4 and contributors",
  "homepage": "https://github.com/Hexadecinull/WebSquared",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hexadecinull/WebSquared.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run build:workers && concurrently -n client,server -c cyan,yellow \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:workers && npm run build:server",
    "build:client": "vite build",
    "build:workers": "node scripts/build-workers.mjs",
    "build:server": "tsc -p tsconfig.node.json",
    "start": "node dist-server/server/index.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^5.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@sveltejs/vite-plugin-svelte": "5.1.1",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "22.10.5",
    "@types/ws": "^8.5.13",
    "concurrently": "9.2.4",
    "eslint": "9.39.4",
    "eslint-plugin-svelte": "2.46.1",
    "esbuild": "0.24.2",
    "globals": "15.15.0",
    "svelte": "5.56.6",
    "svelte-check": "4.4.8",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.2",
    "vite": "6.4.3"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  }
}
