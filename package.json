{
  "name": "websquared",
  "version": "0.2.1",
  "description": "Ad-free, open-source, lightweight web proxy",
  "license": "AGPL-3.0-only",
  "author": "SSMG4 and contributors",
  "homepage": "https://github.com/Hexadecinull/WebSquared",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hexadecinull/WebSquared.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run build:workers && concurrently -n client,server -c cyan,yellow \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch src/server/index.ts",
    "build": "npm run build:client && npm run build:workers && npm run build:server",
    "build:client": "vite build",
    "build:workers": "node scripts/build-workers.mjs",
    "build:server": "tsc -p tsconfig.node.json",
    "start": "node dist-server/server/index.js",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/eslint": "^9.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "26.6.4",
    "@types/ws": "^8.5.13",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.27.7": true,
    "esbuild@0.25.12": true
  }
}
