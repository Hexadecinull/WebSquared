# Copy this file to .env on the server and fill in real values.
# .env is gitignored — it will never be committed, and `git reset --hard`
# during auto-deploys will never touch or overwrite it.

# A long random secret shared with GitHub's webhook config.
# Generate one with: openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=

# Port the deploy webhook listener runs on (only bound to 127.0.0.1).
DEPLOY_WEBHOOK_PORT=9000

# Branch that triggers an auto-deploy when pushed to.
DEPLOY_BRANCH=main

# Absolute path to the repo on the server.
DEPLOY_REPO_DIR=/var/www/websquared

# Name of the PM2 process to restart after a successful build.
DEPLOY_PM2_APP=websquared
